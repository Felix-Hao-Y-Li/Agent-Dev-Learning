# 复制本文件为 .env 后填入真实值；.env 不会被提交
# ---- 必填 ----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- 以下均有默认值，按需覆盖 ----
# LOG_LEVEL=INFO
# LLM_MODEL=deepseek:deepseek-v4-flash
# LLM_TIMEOUT_SECONDS=30
# EMBEDDING_DEVICE=cuda
# RETRIEVAL_TOP_K=4

# ---- HuggingFace 行为开关（app/__init__.py 里有默认值，这里可覆盖）----
# 只用本地模型缓存、不联网。第一次要下载模型时临时改成 0
# HF_HUB_OFFLINE=1
# 不打印模型加载进度条，保证 stdout 只有 JSON 日志
# HF_HUB_DISABLE_PROGRESS_BARS=1
